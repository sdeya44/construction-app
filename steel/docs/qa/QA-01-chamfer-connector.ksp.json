":"P2","face":"z+","along":"0","across":"-(g/2 - (nc-1)*pc/2)"},"rows":"nr","cols":"nc","px":"pc","py":"p/max(nr-1, 1)","d0":"d0"},{"k":"holes","id":"H2","ref":{"on":"P2","face":"z+","along":"0","across":"(g/2 - (nc-1)*pc/2)"},"rows":"nr","cols":"nc","px":"pc","py":"p/max(nr-1, 1)","d0":"d0"},{"k":"bolts","id":"B1","holes":"H1","d":"d","grade":"8.8","site":true,"noMain":true,"noHost":true},{"k":"bolts","id":"B2","holes":"H2","d":"d","grade":"8.8","site":true,"noMain":true,"noHost":true},{"k":"weld","id":"W1","part":"P1","a":"max(4, ceil(mt))","site":false,"to":"host"},{"k":"weld","id":"W2","part":"P2","a":"max(4, ceil(mt))","site":false,"to":"main"}]}],"detailAssign":{"KB.F1.L.L.R|start":"preset-plate-plate-cham","KB.F1.L.L.R|end":"preset-plate-plate-cham","KB.F1.R.R.L|start":"preset-plate-plate-cham","KB.F1.R.R.L|end":"preset-plate-plate-cham","KB.F2.L.L.R|start":"preset-plate-plate-cham","KB.F2.L.L.R|end":"preset-plate-plate-cham","KB.F2.R.R.L|start":"preset-plate-plate-cham","KB.F2.R.R.L|end":"preset-plate-plate-cham","KB.F3.L.L.R|start":"preset-plate-plate-cham","KB.F3.L.L.R|end":"preset-plate-plate-cham","KB.F3.R.R.L|start":"preset-plate-plate-cham","KB.F3.R.R.L|end":"preset-plate-plate-cham"}}