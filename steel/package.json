{
  "name": "kayan-steel-pro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "KAYAN STEEL PRO — מידול פרמטרי ופירוט פלדה",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "test:all": "npm run typecheck && npm test && npm run build && npm run test:e2e",
    "release": "vite build && node scripts-singlefile.mjs"
  },
  "dependencies": {
    "@fontsource/assistant": "^5.3.0",
    "@fontsource/frank-ruhl-libre": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "dejavu-fonts-ttf": "^2.37.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
